# Copy to .env and fill in. The four secrets have no defaults on purpose:
# the stack refuses to start without them rather than booting insecure.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --------------------------------------------------------------- required

# Signs the session cookie. Changing it signs everyone out.
SESSION_SECRET=

# Shared by the app and n8n. Every webhook and every callback is signed with
# it, in both directions. If these two ever disagree, pipelines stop and the
# app reports a signature mismatch.
PIPELINE_SECRET=

POSTGRES_PASSWORD=

# MinIO root credentials, also used by the app and by n8n's S3 credential.
S3_ACCESS_KEY=nca-media-access
S3_SECRET_KEY=

# The first admin account, used once by `docker compose run --rm seed`.
ADMIN_EMAIL=media@yourchurch.org
ADMIN_PASSWORD=
ADMIN_NAME=Media lead

# --------------------------------------------------------------- optional

ORG_NAME=New Covenant Assembly
ORG_SLUG=new-covenant

POSTGRES_USER=nca
POSTGRES_DB=nca
S3_BUCKET=nca-media

# The address people type to reach the app. On a church's own network that is
# often a plain http:// LAN address, and this is how the app knows not to mark
# the session cookie Secure. A Secure cookie sent over HTTP is dropped by the
# browser with no error, which looks exactly like sign-in doing nothing.
# Put your https:// address here once TLS is in front, or set COOKIE_SECURE.
PUBLIC_URL=http://localhost:3000
# COOKIE_SECURE=true

# Where a browser reaches MinIO. Presigned upload URLs are signed for this
# host, so it has to match what people actually type. On a server, set it to
# that machine's address or hostname.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Where n8n is reachable from a browser, for the editor and webhook URLs.
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=Europe/London

# Voice providers. Kokoro runs locally under the "voice" profile. Fish is a
# hosted API and needs a key. Kokoro's English is strong and its French is
# weaker, so for a French voice prefer Fish and listen before committing.
KOKORO_URL=http://kokoro:8880
FISH_API_KEY=

# Used by the Shorts and translation pipelines, and by poster style extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ------------------------------------------------------- poster creator
# The templates app and render-api come up with the rest of the stack.
#   templates   http://localhost:3100   the visual layer, screenshotted
#   render-api  http://localhost:3200   owns Playwright, writes PNGs to MinIO
#
# Neither has a home page. templates only answers on
# /render/{brandId}/{template} and /api/health; render-api on /health and
# POST /render.

# Where the browser loads the preview iframe from. A host address, not a
# compose hostname, because this one is resolved by the person's browser.
NEXT_PUBLIC_TEMPLATES_URL=http://localhost:3100

# Object key prefixes inside the existing bucket, so poster output never
# collides with sermon audio or announcement video.
RENDER_MINIO_PREFIX=posters/
REFERENCE_MINIO_PREFIX=refs/

# How many browser contexts render-api keeps warm. Each costs memory; three is
# comfortable on a small machine and renders about five posters a second.
PLAYWRIGHT_POOL_SIZE=3

# ------------------------------------------------ local development only
# Running `npm run dev` outside Docker, against the compose services:
# DATABASE_URL=postgres://nca:yourpassword@localhost:5432/nca
# APP_URL=http://host.docker.internal:3000
# N8N_BASE_URL=http://localhost:5678
# S3_ENDPOINT=http://localhost:9000
