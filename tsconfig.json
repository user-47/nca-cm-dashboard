{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "es2022",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // The services are separate apps with their own tsconfig and their own React
  // major. Type-checking them from here would judge React 19 components against
  // this app's React 18 types and fail on JSX that is perfectly valid in situ.
  // Each is checked by its own `npm run typecheck`.
  "exclude": ["node_modules", "services", "packages/*/dist"]
}
